  "headings": [
    {
      "tag": "h1",
      "text": "We Reply"
    },
    {
      "tag": "h2",
      "text": "At Reply, we help you turn your vision into reality: we combine our strategic and creative approach with today's cutting-edge technologies to start making things happen from day one."
    },
    {
      "tag": "h2",
      "text": "Explore our stories"
    },
    {
      "tag": "h2",
      "text": "These three assets can be found at the core of every Reply project. It is by letting them enrich and bolster each other that we bring actionable solutions to a wide range of industries and topics."
    },
    {
      "tag": "h2",
      "text": "We make innovation happen."
    },
    {
      "tag": "h2",
      "text": "We are a decentralized network of specialised companies."
    },
    {
      "tag": "h2",
      "text": "Always aiming a little higher."
    },
    {
      "tag": "h2",
      "text": "Lead the way, act sustainably."
    }
  ],
